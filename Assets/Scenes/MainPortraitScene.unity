    - target: {fileID: 6183211337144991914, guid: ae5f7a3ea3ee4e14a8cf94a456e102ca, type: 3}
      propertyPath: m_text
      value: "\u2022 Filinvest City, Alabang (13km)\n\u2022 Makati Central Business
        District (21km)\n\u2022 Bonifacio Global City, Taguig (23km)\n\u2022 Nuvali
        Evoliving Center, Laguna (30km)"
