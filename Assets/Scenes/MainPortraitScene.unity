    - target: {fileID: 5633951855702518726, guid: ae5f7a3ea3ee4e14a8cf94a456e102ca, type: 3}
      propertyPath: m_text
      value: Treelane Residences is a townhouse development located in Brgy. Bucandala,
        Imus, Cavite. Designed for growing families, the community offers convenient
        access to schools, shopping malls, leisure destinations, and major business
        hubs in the South and Metro Manila.
      objectReference: {fileID: 0}
    - target: {fileID: 5633951855702518726, guid: ae5f7a3ea3ee4e14a8cf94a456e102ca, type: 3}
      propertyPath: m_fontSize
      value: 30
      objectReference: {fileID: 0}
    - target: {fileID: 5633951855702518726, guid: ae5f7a3ea3ee4e14a8cf94a456e102ca, type: 3}
      propertyPath: m_fontSizeBase
      value: 30
      objectReference: {fileID: 0}
    - target: {fileID: 5741039445863638462, guid: ae5f7a3ea3ee4e14a8cf94a456e102ca, type: 3}
      propertyPath: m_text
      value: "\u2022 Imus Unida Christian School (2km)\n\u2022 Imus National High
        School (3.2km)\n\u2022 De La Salle Santiago Zobel \u2013 Vermosa (8.5km)\n\u2022
        Philippine Christian University \u2013 Dasmari\xF1as (10km)\n\u2022 British
        School Manila, BGC (23km)"
      objectReference: {fileID: 0}
    - target: {fileID: 5741039445863638462, guid: ae5f7a3ea3ee4e14a8cf94a456e102ca, type: 3}
